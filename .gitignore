
# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
**/.env
**/.env.*
!.env.example
**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Cloud credentials
credentials.json
service-account*.json
secrets/
.secrets/

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/
.pnp/
.pnp.js

# ==========================================
# BUILD OUTPUTS
# ==========================================
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
coverage/

# ==========================================
# LOGS & DEBUG FILES
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# LOCAL DATABASES & UPLOADS
# ==========================================
*.sqlite
*.sqlite3
*.db
uploads/
tmp/
temp/

# ==========================================
# FRONTEND / TOOL CACHES
# ==========================================
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ==========================================
# PYTHON (IF USED BY BACKEND TOOLS)
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ==========================================
# EDITORS & OPERATING SYSTEM
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.bak

# ==========================================
# TEST & REPORT OUTPUTS
# ==========================================
.nyc_output/
playwright-report/
test-results/

# ==========================================
# OPTIONAL LOCAL CONFIGURATION
# ==========================================
.env.local
.env.development.local
.env.test.local
.env.production.local
